# Controller input check (E0c, DETERMINISM R14): a scripted START press at frame
# PRESS must change the run after that frame and not before, and two runs with the
# same script must be byte-identical. Run by ctest as `local_input_start` (needs
# the disc); the script is written here, the logs stay in the build tree.
#   cmake -DBOOT=<mvp-boot> [-DEMULATOR=<runner, e.g. node>] -DWORK=<dir> -DPRESS=F -DFRAMES=N -P input.cmake
if(NOT PRESS)
  set(PRESS 280)
endif()
if(NOT FRAMES)
  set(FRAMES 290)
endif()
set(script "${WORK}/input_start.txt")
file(WRITE "${script}" "mvp-input 1\n# E0c local test: tap START on port 1\n${PRESS} 1 tap 3 START\n")
foreach(run a1 a2 b)
  set(input_args)
  if(NOT run STREQUAL "b")
    set(input_args --input "${script}")
  endif()
  execute_process(
    COMMAND ${EMULATOR} "${BOOT}" run --until none --mmio 0 --max-entries 4000000000 --max-ticks 40000000000 --frames ${FRAMES}
            ${input_args} --log "${WORK}/input_${run}.log" --frame-log "${WORK}/input_${run}.frames"
    WORKING_DIRECTORY "${WORK}"
    OUTPUT_VARIABLE out_${run}
    RESULT_VARIABLE rc_${run})
  if(rc_${run} EQUAL 77)
    message("SKIP: no disc")
    cmake_language(EXIT 77)
  endif()
  if(NOT out_${run} MATCHES "stopped: ran ${FRAMES} frames")
    string(REGEX MATCH "stopped: [^\n]*" stop "${out_${run}}")
    message(FATAL_ERROR "run ${run} did not run ${FRAMES} frames: ${stop}")
  endif()
  string(REPLACE "input_${run}." "input." out_${run} "${out_${run}}")
endforeach()
string(REGEX MATCH "SDK call log: [^\n]*" log_a "${out_a1}")
string(REGEX MATCH "SDK call log: [^\n]*" log_b "${out_b}")
message("with the press:    ${log_a}")
message("without the press: ${log_b}")
if(NOT out_a1 STREQUAL out_a2)
  file(WRITE "${WORK}/input_a1.txt" "${out_a1}")
  file(WRITE "${WORK}/input_a2.txt" "${out_a2}")
  message(FATAL_ERROR "two runs with the same script differ (reports in ${WORK}/input_a1.txt and input_a2.txt)")
endif()
if(log_a STREQUAL log_b)
  message(FATAL_ERROR "the START press did not change the SDK call log")
endif()
# The frame logs: identical (time base, SDK calls so far) up to the press, then different.
file(STRINGS "${WORK}/input_a1.frames" fa)
file(STRINGS "${WORK}/input_b.frames" fb)
list(LENGTH fa na)
list(LENGTH fb nb)
if(NOT na EQUAL nb)
  message(FATAL_ERROR "frame logs have ${na} and ${nb} lines")
endif()
set(first "")
math(EXPR last "${na} - 1")
foreach(i RANGE 0 ${last})
  list(GET fa ${i} la)
  list(GET fb ${i} lb)
  string(REGEX REPLACE " in [0-9a-f]+$" "" la "${la}")
  string(REGEX REPLACE " in [0-9a-f]+$" "" lb "${lb}")
  if(NOT la STREQUAL lb)
    set(first ${i})
    break()
  endif()
endforeach()
if(first STREQUAL "")
  message(FATAL_ERROR "the frame logs never differ")
endif()
if(first LESS_EQUAL PRESS)
  message(FATAL_ERROR "the runs differ at frame ${first}, before the press is consumed (frame ${PRESS})")
endif()
message("first frame that differs: ${first} (press at frame ${PRESS})")
message("PASS: the press changes the run after frame ${PRESS}; two runs with it are identical")
