{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "../../build/engine/emscripten/web/site"
  },
  "include": ["src/*.ts"]
}
