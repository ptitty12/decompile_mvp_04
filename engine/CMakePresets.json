{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/engine/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC + Ninja (run inside a vcvars64 environment: engine/tools/msvc.cmd)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "vs",
      "displayName": "Visual Studio generator (no vcvars needed)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "clang",
      "displayName": "clang + Ninja",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "emscripten",
      "displayName": "Emscripten + Ninja: wasm32, tests under Node (run inside engine/tools/emsdk.cmd)",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MVP_GFX_WEBGPU": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "msvc", "configurePreset": "msvc" },
    { "name": "vs", "configurePreset": "vs", "configuration": "RelWithDebInfo" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "emscripten", "configurePreset": "emscripten" }
  ],
  "testPresets": [
    { "name": "msvc", "configurePreset": "msvc", "output": { "outputOnFailure": true } },
    { "name": "vs", "configurePreset": "vs", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "clang", "configurePreset": "clang", "output": { "outputOnFailure": true } },
    { "name": "emscripten", "configurePreset": "emscripten", "output": { "outputOnFailure": true } }
  ]
}
