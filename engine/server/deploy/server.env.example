# /etc/mvp/server.env (mode 0640, root:mvp). Secrets live in their own files
# (mode 0640, root:mvp), never in the repository.
MVP_SERVER_CONFIG=/etc/mvp/server.json
MVP_TURN_SECRET_FILE=/etc/mvp/turn-secret
# There is no site password here: a fresh install starts in setup mode and the
# owner creates the password in the browser on the first visit (the scrypt hash
# goes to "stateFile" in server.json, /var/lib/mvp/state.json). Setting
# MVP_PASSWORD_FILE=<file> would override that (tests, CI); install.sh adds it
# only when an older install already has /etc/mvp/password.
